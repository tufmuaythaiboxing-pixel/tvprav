# ================================================================
# CENTRAL DE TV — CONFIGURAÇÃO DE AMBIENTE
# ================================================================

# Token do Bot Telegram oficial obtido através do @BotFather
# Exemplo: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN="SEU_TELEGRAM_BOT_TOKEN_AQUI"

# Telegram ID do Proprietário Absoluto com Acesso TOTAL permanente
# Padrão oficial: 6918626496
OWNER_ID="6918626496"

# URL pública da aplicação (necessário para Webhooks do Telegram se ativado)
APP_URL="https://seu-dominio.com"

# Porta do servidor HTTP / Painel Web (padrão: 3000)
PORT=3000

# Ambiente de execução (development | production)
NODE_ENV=production
